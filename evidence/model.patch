+package converge
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+	"github.com/mariadb-operator/mariadb-operator/v26/pkg/maxscale/graph"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+func newTestDesiredGraph() *graph.Graph {
+	return graph.DesiredFromSpec(&mariadbv1alpha1.MaxScale{
+		Spec: mariadbv1alpha1.MaxScaleSpec{
+			Replicas: 2,
+			Servers: []mariadbv1alpha1.MaxScaleServer{
+				{Name: "mdb-0", Address: "mdb-0.mdb-internal.default.svc.cluster.local", Port: 3306, Protocol: "MariaDBBackend"},
+				{Name: "mdb-1", Address: "mdb-1.mdb-internal.default.svc.cluster.local", Port: 3306, Protocol: "MariaDBBackend"},
+			},
+			Monitor: mariadbv1alpha1.MaxScaleMonitor{
+				Name:     "mdb-monitor",
+				Module:   mariadbv1alpha1.MonitorModuleMariadb,
+				Interval: metav1.Duration{Duration: 2 * time.Second},
+			},
+			Services: []mariadbv1alpha1.MaxScaleService{
+				{
+					Name:   "rw-router",
+					Router: mariadbv1alpha1.ServiceRouterReadWriteSplit,
+					Listener: mariadbv1alpha1.MaxScaleListener{
+						Name: "rw-listener", Port: 3306, Protocol: "MariaDBProtocol",
+					},
+				},
+			},
+		},
+	})
+}
+
+type fakePodAPI struct {
+	version        int
+	err            error
+	matched        map[string]bool
+	running        map[string]bool
+	monitorServers map[string][]string
+	serviceRels    map[string]serviceRel
+}
+
+type serviceRel struct {
+	servers []string
+	filters []string
+}
+
+func newFakePodAPI() *fakePodAPI {
+	return &fakePodAPI{
+		matched:        map[string]bool{},
+		running:        map[string]bool{},
+		monitorServers: map[string][]string{},
+		serviceRels:    map[string]serviceRel{},
+	}
+}
+
+func (f *fakePodAPI) key(kind, id string) string {
+	return fmt.Sprintf("%s/%s", kind, id)
+}
+
+func (f *fakePodAPI) ConfigSyncVersion(context.Context) (int, error) { return f.version, f.err }
+func (f *fakePodAPI) ServerMatches(_ context.Context, d graph.Server) (bool, error) {
+	return f.matched[f.key("servers", d.Name)], f.err
+}
+func (f *fakePodAPI) FilterMatches(_ context.Context, d graph.Filter) (bool, error) {
+	return f.matched[f.key("filters", d.Name)], f.err
+}
+func (f *fakePodAPI) MonitorMatches(_ context.Context, d graph.Monitor) (bool, error) {
+	return f.matched[f.key("monitors", d.Name)], f.err
+}
+func (f *fakePodAPI) ServiceMatches(_ context.Context, d graph.Service) (bool, error) {
+	return f.matched[f.key("services", d.Name)], f.err
+}
+func (f *fakePodAPI) ListenerMatches(_ context.Context, d graph.Listener) (bool, error) {
+	return f.matched[f.key("listeners", d.Name)], f.err
+}
+func (f *fakePodAPI) ListenerRunning(_ context.Context, d graph.Listener) (bool, error) {
+	return f.running[d.Name], f.err
+}
+func (f *fakePodAPI) MonitorServers(_ context.Context, name string) ([]string, error) {
+	return f.monitorServers[name], f.err
+}
+func (f *fakePodAPI) ServiceRelationships(_ context.Context, name string) ([]string, []string, error) {
+	rels := f.serviceRels[name]
+	return rels.servers, rels.filters, f.err
+}
+
+var _ PodAPI = &fakePodAPI{}
+
+func newChecker(ha bool) (*Checker, *graph.Graph) {
+	desired := newTestDesiredGraph()
+	checker := NewChecker(desired, ha, time.Second, func(context.Context) (int, error) {
+		return 5, nil
+	})
+	return checker, desired
+}
+
+func markConverged(f *fakePodAPI, g *graph.Graph) {
+	for _, id := range g.ObjectIDs().Servers {
+		f.matched[f.key("servers", id)] = true
+	}
+	for _, id := range g.ObjectIDs().Monitor {
+		f.matched[f.key("monitors", id)] = true
+		f.monitorServers[id] = g.Monitors[id].Servers
+	}
+	for _, id := range g.ObjectIDs().Services {
+		f.matched[f.key("services", id)] = true
+		svc := g.Services[id]
+		f.serviceRels[id] = serviceRel{servers: svc.Servers, filters: svc.Filters}
+	}
+	for _, id := range g.ObjectIDs().Listeners {
+		f.matched[f.key("listeners", id)] = true
+		f.running[id] = true
+	}
+}
+
+func newTestObjs(g *graph.Graph) Objects {
+	return Objects{
+		Servers:          g.ObjectIDs().Servers,
+		Monitors:         g.ObjectIDs().Monitor,
+		Services:         g.ObjectIDs().Services,
+		Listeners:        g.ObjectIDs().Listeners,
+		MonitorRelations: g.ObjectIDs().Monitor,
+		ServiceRelations: g.ObjectIDs().Services,
+		RunningListeners: g.ObjectIDs().Listeners,
+	}
+}
+
+var _ = Describe("MaxScale config convergence barrier", func() {
+	It("waits when an HA Pod lags the database config sync version", func() {
+		checker, desired := newChecker(true)
+		pod0 := newFakePodAPI()
+		pod0.version = 5
+		pod1 := newFakePodAPI()
+		pod1.version = 4
+		converged, err := checker.Converged(context.Background(),
+			map[string]PodAPI{"mxs-0": pod0, "mxs-1": pod1}, newTestObjs(desired))
+		Expect(err).ToNot(HaveOccurred())
+		Expect(converged).To(BeFalse())
+	})
+
+	It("returns errors when a Pod is unreachable", func() {
+		checker, desired := newChecker(true)
+		pod0 := newFakePodAPI()
+		pod0.version = 5
+		pod1 := newFakePodAPI()
+		pod1.version = 5
+		pod1.err = fmt.Errorf("connection refused")
+		markConverged(pod0, desired)
+		markConverged(pod1, desired)
+		converged, err := checker.Converged(context.Background(),
+			map[string]PodAPI{"mxs-0": pod0, "mxs-1": pod1}, newTestObjs(desired))
+		Expect(err).To(HaveOccurred())
+		Expect(converged).To(BeFalse())
+	})
+
+	It("waits when an expected object is missing on a Pod", func() {
+		checker, desired := newChecker(false)
+		pod := newFakePodAPI()
+		pod.matched["servers/mdb-0"] = true
+		pod.matched["monitors/mdb-monitor"] = true
+		pod.matched["services/rw-router"] = true
+		// rw-listener intentionally absent and unmatched.
+		converged, err := checker.Converged(context.Background(),
+			map[string]PodAPI{"mxs-0": pod}, newTestObjs(desired))
+		Expect(err).ToNot(HaveOccurred())
+		Expect(converged).To(BeFalse())
+	})
+
+	It("passes when every Pod converges, including entry-point state and relationships", func() {
+		checker, desired := newChecker(true)
+		pod0 := newFakePodAPI()
+		pod0.version = 5
+		pod1 := newFakePodAPI()
+		pod1.version = 5
+		markConverged(pod0, desired)
+		markConverged(pod1, desired)
+		converged, err := checker.Converged(context.Background(),
+			map[string]PodAPI{"mxs-0": pod0, "mxs-1": pod1}, newTestObjs(desired))
+		Expect(err).ToNot(HaveOccurred())
+		Expect(converged).To(BeTrue())
+	})
+})
diff --git a/pkg/maxscale/converge/objects.go b/pkg/maxscale/converge/objects.go
new file mode 100644
index 00000000..5adac984
--- /dev/null
+++ b/pkg/maxscale/converge/objects.go
@@ -0,0 +1,98 @@
+package converge
+
+import (
+	"context"
+	"fmt"
+
+	mxsclient "github.com/mariadb-operator/mariadb-operator/v26/pkg/maxscale/client"
+	"github.com/mariadb-operator/mariadb-operator/v26/pkg/maxscale/graph"
+)
+
+func (c *Checker) podConverged(ctx context.Context, api PodAPI, objs Objects) (bool, error) {
+	if ok, err := allMatch(ctx, objs.Servers, nodeOf(c.desired.Servers), api.ServerMatches, "server"); !ok || err != nil {
+		return false, err
+	}
+	if ok, err := allMatch(ctx, objs.Filters, nodeOf(c.desired.Filters), api.FilterMatches, "filter"); !ok || err != nil {
+		return false, err
+	}
+	if ok, err := allMatch(ctx, objs.Monitors, nodeOf(c.desired.Monitors), api.MonitorMatches, "monitor"); !ok || err != nil {
+		return false, err
+	}
+	if ok, err := allMatch(ctx, objs.Services, nodeOf(c.desired.Services), api.ServiceMatches, "service"); !ok || err != nil {
+		return false, err
+	}
+	if ok, err := allMatch(ctx, objs.Listeners, nodeOf(c.desired.Listeners), api.ListenerMatches, "listener"); !ok || err != nil {
+		return false, err
+	}
+
+	if ok, err := c.monitorRelationsConverged(ctx, api, objs.MonitorRelations); !ok || err != nil {
+		return false, err
+	}
+	if ok, err := c.serviceRelationsConverged(ctx, api, objs.ServiceRelations); !ok || err != nil {
+		return false, err
+	}
+	return allMatch(ctx, objs.RunningListeners, nodeOf(c.desired.Listeners), api.ListenerRunning, "listener")
+}
+
+// nodeOf returns a value lookup for use with allMatch, keeping the call sites compact.
+func nodeOf[T any](m map[string]T) func(string) T {
+	return func(key string) T {
+		return m[key]
+	}
+}
+
+// allMatch reports whether every desired node matches its live counterpart. A not-found
+// counterpart is a retriable "not converged" answer rather than a transport error.
+func allMatch[T any](ctx context.Context, ids []string, desired func(string) T,
+	match func(context.Context, T) (bool, error), kind string) (bool, error) {
+	for _, id := range ids {
+		matches, err := match(ctx, desired(id))
+		if err != nil {
+			return false, errExistingOrObject(kind, id, err)
+		}
+		if !matches {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// errExistingOrObject turns a missing object into a "not converged yet" answer and
+// propagates any transport error with object context.
+func errExistingOrObject(kind, id string, err error) error {
+	if mxsclient.IsNotFound(err) {
+		return nil
+	}
+	return errObject(kind, id, err)
+}
+
+func errObject(kind, id string, err error) error {
+	return fmt.Errorf("error matching %s '%s': %v", kind, id, err)
+}
+
+func (c *Checker) monitorRelationsConverged(ctx context.Context, api PodAPI, ids []string) (bool, error) {
+	for _, id := range ids {
+		servers, err := api.MonitorServers(ctx, id)
+		if err != nil {
+			return false, errExistingOrObject("monitor", id, err)
+		}
+		if !graph.SameStrings(servers, c.desired.Monitors[id].Servers) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func (c *Checker) serviceRelationsConverged(ctx context.Context, api PodAPI, ids []string) (bool, error) {
+	for _, id := range ids {
+		servers, filters, err := api.ServiceRelationships(ctx, id)
+		if err != nil {
+			return false, errExistingOrObject("service", id, err)
+		}
+		desired := c.desired.Services[id]
+		if !graph.SameStrings(servers, desired.Servers) || !graph.SameStrings(filters, desired.Filters) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
diff --git a/pkg/maxscale/graph/fingerprint.go b/pkg/maxscale/graph/fingerprint.go
new file mode 100644
index 00000000..ff42e87c
--- /dev/null
+++ b/pkg/maxscale/graph/fingerprint.go
@@ -0,0 +1,128 @@
+package graph
+
+import (
+	"fmt"
+
+	"github.com/mariadb-operator/mariadb-operator/v26/pkg/hash"
+)
+
+// Hash returns the canonical fingerprint of the whole desired graph.
+// It excludes credentials, which are never part of the graph.
+func (g *Graph) Hash() (string, error) {
+	h, err := hash.HashJSON(g.canonical())
+	if err != nil {
+		return "", fmt.Errorf("error hashing graph: %v", err)
+	}
+	return h, nil
+}
+
+// ServerFingerprint returns the fingerprint of a server configuration, excluding its identity.
+func (g *Graph) ServerFingerprint(id string) (string, bool, error) {
+	srv, ok := g.Servers[id]
+	if !ok {
+		return "", false, nil
+	}
+	srv.Name = ""
+	h, err := hash.HashJSON(srv)
+	if err != nil {
+		return "", true, fmt.Errorf("error hashing server '%s': %v", id, err)
+	}
+	return h, true, nil
+}
+
+// FilterFingerprint returns the fingerprint of a filter configuration, excluding its identity.
+func (g *Graph) FilterFingerprint(id string) (string, bool, error) {
+	filter, ok := g.Filters[id]
+	if !ok {
+		return "", false, nil
+	}
+	filter.Name = ""
+	h, err := hash.HashJSON(filter)
+	if err != nil {
+		return "", true, fmt.Errorf("error hashing filter '%s': %v", id, err)
+	}
+	return h, true, nil
+}
+
+// MonitorFingerprint returns the fingerprint of the monitor configuration, excluding its identity.
+func (g *Graph) MonitorFingerprint(id string) (string, bool, error) {
+	mon, ok := g.Monitors[id]
+	if !ok {
+		return "", false, nil
+	}
+	mon.Name = ""
+	h, err := hash.HashJSON(mon)
+	if err != nil {
+		return "", true, fmt.Errorf("error hashing monitor '%s': %v", id, err)
+	}
+	return h, true, nil
+}
+
+// ServiceFingerprint returns the fingerprint of a service configuration, excluding its identity.
+func (g *Graph) ServiceFingerprint(id string) (string, bool, error) {
+	svc, ok := g.Services[id]
+	if !ok {
+		return "", false, nil
+	}
+	svc.Name = ""
+	svc.Listener.Name = ""
+	h, err := hash.HashJSON(svc)
+	if err != nil {
+		return "", true, fmt.Errorf("error hashing service '%s': %v", id, err)
+	}
+	return h, true, nil
+}
+
+// ListenerFingerprint returns the fingerprint of a listener configuration, excluding its identity.
+func (g *Graph) ListenerFingerprint(id string) (string, bool, error) {
+	listener, ok := g.Listeners[id]
+	if !ok {
+		return "", false, nil
+	}
+	listener.Name = ""
+	h, err := hash.HashJSON(listener)
+	if err != nil {
+		return "", true, fmt.Errorf("error hashing listener '%s': %v", id, err)
+	}
+	return h, true, nil
+}
+
+type canonicalGraph struct {
+	Servers   []Server  `json:"servers"`
+	Filters   []Filter  `json:"filters"`
+	Monitors  []Monitor `json:"monitors"`
+	Services  []Service `json:"services"`
+	Listeners []Listener `json:"listeners"`
+}
+
+// canonical returns a slice-based, sorted representation of the graph so the
+// fingerprint does not depend on Go map iteration order.
+func (g *Graph) canonical() canonicalGraph {
+	servers := make([]Server, 0, len(g.Servers))
+	for _, id := range g.serverIDs() {
+		servers = append(servers, g.Servers[id])
+	}
+	filters := make([]Filter, 0, len(g.Filters))
+	for _, id := range g.filterIDs() {
+		filters = append(filters, g.Filters[id])
+	}
+	monitors := make([]Monitor, 0, len(g.Monitors))
+	for _, id := range g.monitorIDs() {
+		monitors = append(monitors, g.Monitors[id])
+	}
+	services := make([]Service, 0, len(g.Services))
+	for _, id := range g.serviceIDs() {
+		services = append(services, g.Services[id])
+	}
+	listeners := make([]Listener, 0, len(g.Listeners))
+	for _, id := range g.listenerIDs() {
+		listeners = append(listeners, g.Listeners[id])
+	}
+	return canonicalGraph{
+		Servers:   servers,
+		Filters:   filters,
+		Monitors:  monitors,
+		Services:  services,
+		Listeners: listeners,
+	}
+}
diff --git a/pkg/maxscale/graph/graph.go b/pkg/maxscale/graph/graph.go
new file mode 100644
index 00000000..b1e60547
--- /dev/null
+++ b/pkg/maxscale/graph/graph.go
@@ -0,0 +1,216 @@
+package graph
+
+import (
+	"sort"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+)
+
+// ServerTLS holds the spec-derived TLS flags that are part of a server REST configuration.
+type ServerTLS struct {
+	Enabled               bool
+	VerifyPeerCertificate bool
+	VerifyPeerHost        bool
+	ReplicationSSLEnabled bool
+}
+
+// Server is a desired MaxScale server node.
+type Server struct {
+	Name        string
+	Address     string
+	Port        int32
+	Protocol    string
+	Maintenance bool
+	TLS         ServerTLS
+	Params      map[string]string
+}
+
+// Filter is a desired MaxScale filter node.
+type Filter struct {
+	Name   string
+	Module string
+	Params map[string]string
+}
+
+// Monitor is the desired MaxScale monitor node and its server relationships.
+type Monitor struct {
+	Name                  string
+	Module                mariadbv1alpha1.MonitorModule
+	IntervalMillis        int64
+	CooperativeMonitoring *mariadbv1alpha1.CooperativeMonitoring
+	Suspend               bool
+	Servers               []string
+	Params                map[string]string
+}
+
+// Listener is the desired entry point attached to a service.
+type Listener struct {
+	Name     string
+	Port     int32
+	Protocol string
+	Suspend  bool
+	TLS      bool
+	Params   map[string]string
+}
+
+// Service is a desired MaxScale routing service node.
+type Service struct {
+	Name     string
+	Router   mariadbv1alpha1.ServiceRouter
+	Suspend  bool
+	Servers  []string
+	Filters  []string
+	Listener Listener
+	Params   map[string]string
+}
+
+// Graph is the spec-derived dependency graph managed via the MaxScale REST API.
+// It deliberately excludes credentials: monitor and service passwords are not part of the graph.
+type Graph struct {
+	Servers   map[string]Server
+	Filters   map[string]Filter
+	Monitors  map[string]Monitor
+	Services  map[string]Service
+	Listeners map[string]Listener
+}
+
+// DesiredFromSpec builds the desired dependency graph from a defaulted MaxScale spec.
+func DesiredFromSpec(mxs *mariadbv1alpha1.MaxScale) *Graph {
+	serverIDs := mxs.ServerIDs()
+	g := &Graph{
+		Servers:   make(map[string]Server, len(mxs.Spec.Servers)),
+		Filters:   make(map[string]Filter, len(mxs.Spec.Filters)),
+		Monitors:  make(map[string]Monitor, 1),
+		Services:  make(map[string]Service, len(mxs.Spec.Services)),
+		Listeners: make(map[string]Listener, len(mxs.Spec.Services)),
+	}
+
+	serverTLS := ServerTLS{
+		Enabled:               mxs.IsTLSEnabled(),
+		VerifyPeerCertificate: mxs.ShouldVerifyPeerCertificate(),
+		VerifyPeerHost:        mxs.ShouldVerifyPeerHost(),
+		ReplicationSSLEnabled: mxs.IsReplicationSSLEnabled(),
+	}
+	for _, srv := range mxs.Spec.Servers {
+		g.Servers[srv.Name] = Server{
+			Name:        srv.Name,
+			Address:     srv.Address,
+			Port:        srv.Port,
+			Protocol:    srv.Protocol,
+			Maintenance: srv.Maintenance,
+			TLS:         serverTLS,
+			Params:      srv.Params,
+		}
+	}
+
+	for _, filter := range mxs.Spec.Filters {
+		g.Filters[filter.Name] = Filter{
+			Name:   filter.Name,
+			Module: filter.Module,
+			Params: filter.Params,
+		}
+	}
+
+	mon := mxs.Spec.Monitor
+	g.Monitors[mon.Name] = Monitor{
+		Name:                  mon.Name,
+		Module:                mon.Module,
+		IntervalMillis:        mon.Interval.Milliseconds(),
+		CooperativeMonitoring: mon.CooperativeMonitoring,
+		Suspend:               mon.Suspend,
+		Servers:               sortedCopy(serverIDs),
+		Params:                mon.Params,
+	}
+
+	for _, svc := range mxs.Spec.Services {
+		filters := make([]string, len(svc.Filters))
+		copy(filters, svc.Filters)
+		service := Service{
+			Name:    svc.Name,
+			Router:  svc.Router,
+			Suspend: svc.Suspend,
+			Servers: sortedCopy(serverIDs),
+			Filters: filters,
+			Listener: Listener{
+				Name:     svc.Listener.Name,
+				Port:     svc.Listener.Port,
+				Protocol: svc.Listener.Protocol,
+				Suspend:  svc.Listener.Suspend,
+				TLS:      mxs.IsTLSEnabled(),
+				Params:   svc.Listener.Params,
+			},
+			Params: svc.Params,
+		}
+		g.Services[svc.Name] = service
+		g.Listeners[svc.Listener.Name] = service.Listener
+	}
+
+	return g
+}
+
+// ObjectIDs returns the sorted ID set of the graph by kind.
+func (g *Graph) ObjectIDs() *mariadbv1alpha1.MaxScaleConfigObjectIDs {
+	return idsFromSets(
+		newIDSet(g.serverIDs()...),
+		newIDSet(g.filterIDs()...),
+		newIDSet(g.monitorIDs()...),
+		newIDSet(g.serviceIDs()...),
+		newIDSet(g.listenerIDs()...),
+	)
+}
+
+func (g *Graph) serverIDs() []string {
+	ids := make([]string, 0, len(g.Servers))
+	for id := range g.Servers {
+		ids = append(ids, id)
+	}
+	return sortedStrings(ids)
+}
+
+func (g *Graph) filterIDs() []string {
+	ids := make([]string, 0, len(g.Filters))
+	for id := range g.Filters {
+		ids = append(ids, id)
+	}
+	return sortedStrings(ids)
+}
+
+func (g *Graph) monitorIDs() []string {
+	ids := make([]string, 0, len(g.Monitors))
+	for id := range g.Monitors {
+		ids = append(ids, id)
+	}
+	return sortedStrings(ids)
+}
+
+func (g *Graph) serviceIDs() []string {
+	ids := make([]string, 0, len(g.Services))
+	for id := range g.Services {
+		ids = append(ids, id)
+	}
+	return sortedStrings(ids)
+}
+
+func (g *Graph) listenerIDs() []string {
+	ids := make([]string, 0, len(g.Listeners))
+	for id := range g.Listeners {
+		ids = append(ids, id)
+	}
+	return sortedStrings(ids)
+}
+
+func sortedCopy(ids []string) []string {
+	copied := make([]string, len(ids))
+	copy(copied, ids)
+	return sortedStrings(copied)
+}
+
+// SortedCopy returns a sorted copy without modifying the caller's slice.
+func SortedCopy(ids []string) []string {
+	return sortedCopy(ids)
+}
+
+func sortedStrings(ids []string) []string {
+	sort.Strings(ids)
+	return ids
+}
