diff --git a/pkg/maxscale/graph/graph_test.go b/pkg/maxscale/graph/graph_test.go
new file mode 100644
index 00000000..efae04df
--- /dev/null
+++ b/pkg/maxscale/graph/graph_test.go
@@ -0,0 +1,305 @@
+package graph
+
+import (
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+func newTestMaxScale() *mariadbv1alpha1.MaxScale {
+	return &mariadbv1alpha1.MaxScale{
+		Spec: mariadbv1alpha1.MaxScaleSpec{
+			Replicas: 2,
+			Servers: []mariadbv1alpha1.MaxScaleServer{
+				{
+					Name:     "mdb-0",
+					Address:  "mdb-0.mdb-internal.default.svc.cluster.local",
+					Port:     3306,
+					Protocol: "MariaDBBackend",
+				},
+				{
+					Name:     "mdb-1",
+					Address:  "mdb-1.mdb-internal.default.svc.cluster.local",
+					Port:     3306,
+					Protocol: "MariaDBBackend",
+				},
+			},
+			Monitor: mariadbv1alpha1.MaxScaleMonitor{
+				Name:     "mdb-monitor",
+				Module:   mariadbv1alpha1.MonitorModuleMariadb,
+				Interval: metav1.Duration{Duration: 2_000_000_000},
+			},
+			Services: []mariadbv1alpha1.MaxScaleService{
+				{
+					Name:   "rw-router",
+					Router: mariadbv1alpha1.ServiceRouterReadWriteSplit,
+					Listener: mariadbv1alpha1.MaxScaleListener{
+						Name:     "rw-listener",
+						Port:     3306,
+						Protocol: "MariaDBProtocol",
+					},
+				},
+			},
+		},
+	}
+}
+
+func newDesiredGraph() *Graph {
+	return DesiredFromSpec(newTestMaxScale())
+}
+
+var _ = Describe("MaxScale configuration graph", func() {
+	DescribeTable(
+		"validation",
+		func(mutate func(*Graph), expectedErr string) {
+			g := newDesiredGraph()
+			mutate(g)
+			err := g.Validate()
+			if expectedErr == "" {
+				Expect(err).ToNot(HaveOccurred())
+			} else {
+				Expect(err).To(HaveOccurred())
+				Expect(err.Error()).To(ContainSubstring(expectedErr))
+			}
+		},
+		Entry("valid graph", func(*Graph) {}, ""),
+		Entry("service references an undeclared filter", func(g *Graph) {
+			g.Filters["real-filter"] = Filter{Name: "real-filter", Module: "regexfilter"}
+			svc := g.Services["rw-router"]
+			svc.Filters = []string{"missing-filter"}
+			g.Services["rw-router"] = svc
+		}, "references filter 'missing-filter'"),
+		Entry("monitor references an undeclared server", func(g *Graph) {
+			delete(g.Servers, "mdb-1")
+		}, "references server 'mdb-1'"),
+		Entry("duplicated listener port", func(g *Graph) {
+			g.Services["rr-router"] = Service{
+				Name:    "rr-router",
+				Router:  mariadbv1alpha1.ServiceRouterReadConnRoute,
+				Servers: []string{"mdb-0", "mdb-1"},
+				Listener: Listener{
+					Name:     "rr-listener",
+					Port:     3306,
+					Protocol: "MariaDBProtocol",
+				},
+			}
+			g.Listeners["rr-listener"] = g.Services["rr-router"].Listener
+		}, "share the same port 3306"),
+		Entry("duplicated server address", func(g *Graph) {
+			srv := g.Servers["mdb-1"]
+			srv.Address = g.Servers["mdb-0"].Address
+			g.Servers["mdb-1"] = srv
+		}, "share the same address"),
+		Entry("invalid monitor module", func(g *Graph) {
+			mon := g.Monitors["mdb-monitor"]
+			mon.Module = "bogusmon"
+			g.Monitors["mdb-monitor"] = mon
+		}, "monitor 'mdb-monitor' module invalid"),
+	)
+
+	It("hashes a stable whole-graph fingerprint unaffected by credential references", func() {
+		g1 := newDesiredGraph()
+		h1, err := g1.Hash()
+		Expect(err).ToNot(HaveOccurred())
+
+		mxs := newTestMaxScale()
+		mxs.Spec.Auth.MonitorPasswordSecretKeyRef.Name = "changed-secret"
+		mxs.Spec.Auth.ServerPasswordSecretKeyRef.Name = "other-secret"
+		g2 := DesiredFromSpec(mxs)
+		h2, err := g2.Hash()
+		Expect(err).ToNot(HaveOccurred())
+		Expect(h2).To(Equal(h1))
+
+		h1Again, err := DesiredFromSpec(newTestMaxScale()).Hash()
+		Expect(err).ToNot(HaveOccurred())
+		Expect(h1Again).To(Equal(h1))
+	})
+
+	It("adopts desired objects present live and never adopts foreign objects, including port squatters", func() {
+		desired := newDesiredGraph()
+
+		// Rename the desired listener while a foreign holder keeps the same port.
+		newListener := desired.Listeners["rw-listener"]
+		newListener.Name = "blocking-listener"
+		desired.Listeners["blocking-listener"] = newListener
+		delete(desired.Listeners, "rw-listener")
+		svc := desired.Services["rw-router"]
+		delete(desired.Services, "rw-router")
+		svc.Listener = newListener
+		desired.Services["rw-router"] = svc
+
+		live := LiveFromObjectIDs(desired.ObjectIDs())
+		live.Servers.Add("foreign-server")
+		live.Services.Add("foreign-service")
+		live.Listeners.Add("foreign-listener")
+		live.ListenerPorts[3306] = "port-squatter"
+		live.Listeners.Add("port-squatter")
+
+		adopted := Adopt(desired, live)
+		Expect(adopted.Servers).To(ConsistOf("mdb-0", "mdb-1"))
+		Expect(adopted.Services).To(ConsistOf("rw-router"))
+		// The squatter is intentionally NOT adopted: the first post-upgrade change blocks instead
+		// of deleting an object the CR has never owned.
+		Expect(adopted.Listeners).To(ConsistOf("blocking-listener"))
+		Expect(adopted.Monitor).To(ConsistOf("mdb-monitor"))
+	})
+
+	It("classifies creates, parameter patches and ledger-scoped deletes", func() {
+		desired := newDesiredGraph()
+		desired.Servers["mdb-2"] = Server{
+			Name:     "mdb-2",
+			Address:  "mdb-2.mdb-internal.default.svc.cluster.local",
+			Port:     3306,
+			Protocol: "MariaDBBackend",
+		}
+		delete(desired.Servers, "mdb-1")
+		mon := desired.Monitors["mdb-monitor"]
+		mon.Servers = []string{"mdb-0", "mdb-2"}
+		desired.Monitors["mdb-monitor"] = mon
+
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"mdb-0", "mdb-1"},
+			Monitor:   []string{"mdb-monitor"},
+			Services:  []string{"rw-router"},
+			Listeners: []string{"rw-listener"},
+		}
+		live := LiveFromObjectIDs(managed)
+		live.Servers.Add("foreign-server")
+		live.MonitorServers["mdb-monitor"] = []string{"mdb-0", "mdb-1"}
+
+		plan := BuildPlan(desired, managed, live)
+		Expect(plan.Creates.Servers).To(ConsistOf("mdb-2"))
+		Expect(plan.Patches.Servers).To(ContainElement("mdb-0"))
+		Expect(plan.Deletes.Servers).To(ConsistOf("mdb-1"))
+		Expect(plan.Deletes.Servers).ToNot(ContainElement("foreign-server"))
+		Expect(plan.MonitorRelationsSwitch).To(BeTrue())
+	})
+
+	It("supersedes a stale plan by merging its prepared debris into the managed ledger", func() {
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers: []string{"mdb-0"},
+		}
+		stalePrepared := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"stale-server"},
+			Listeners: []string{"stale-listener"},
+			Monitor:   []string{"new-monitor"},
+		}
+
+		merged := Supersede(managed, stalePrepared)
+		Expect(merged.Servers).To(ConsistOf("mdb-0", "stale-server"))
+		Expect(merged.Listeners).To(ConsistOf("stale-listener"))
+		Expect(merged.Monitor).To(ConsistOf("new-monitor"))
+
+		desired := newDesiredGraph()
+		live := LiveFromObjectIDs(merged)
+		plan := BuildPlan(desired, merged, live)
+		Expect(plan.Deletes.Servers).To(ConsistOf("stale-server"))
+		Expect(plan.Deletes.Listeners).To(ConsistOf("stale-listener"))
+		Expect(plan.Deletes.Monitor).To(ConsistOf("new-monitor"))
+	})
+
+	It("recomputes deletions when a newer generation re-declares a stale-plan deletion", func() {
+		desired := newDesiredGraph() // still declares mdb-0 and mdb-1
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"mdb-0", "mdb-1"},
+			Monitor:   []string{"mdb-monitor"},
+			Services:  []string{"rw-router"},
+			Listeners: []string{"rw-listener"},
+		}
+		live := LiveFromObjectIDs(managed)
+		plan := BuildPlan(desired, managed, live)
+		Expect(plan.Deletes.Servers).To(BeEmpty())
+	})
+
+	It("classifies a monitor rename as create plus rename, not as a parameter patch", func() {
+		desired := newDesiredGraph()
+		mon := desired.Monitors["mdb-monitor"]
+		delete(desired.Monitors, "mdb-monitor")
+		mon.Name = "renamed-monitor"
+		desired.Monitors["renamed-monitor"] = mon
+
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"mdb-0", "mdb-1"},
+			Monitor:   []string{"mdb-monitor"},
+			Services:  []string{"rw-router"},
+			Listeners: []string{"rw-listener"},
+		}
+		live := LiveFromObjectIDs(managed)
+		plan := BuildPlan(desired, managed, live)
+
+		Expect(plan.MonitorCreate).To(BeTrue())
+		Expect(plan.MonitorRename).To(BeTrue())
+		Expect(plan.Creates.Monitor).To(ConsistOf("renamed-monitor"))
+		Expect(plan.Patches.Monitor).To(BeEmpty())
+		Expect(plan.Deletes.Monitor).To(ConsistOf("mdb-monitor"))
+	})
+
+	It("defers a same-port listener rename to the switch stage", func() {
+		desired := newDesiredGraph()
+		svc := desired.Services["rw-router"]
+		delete(desired.Services, "rw-router")
+		delete(desired.Listeners, "rw-listener")
+		svc.Name = "split-router"
+		svc.Listener.Name = "split-listener"
+		svc.Listener.Port = 3306
+		desired.Services["split-router"] = svc
+		desired.Listeners["split-listener"] = svc.Listener
+
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"mdb-0", "mdb-1"},
+			Monitor:   []string{"mdb-monitor"},
+			Services:  []string{"rw-router"},
+			Listeners: []string{"rw-listener"},
+		}
+		live := LiveFromObjectIDs(managed)
+		live.ListenerPorts[3306] = "rw-listener"
+		live.ServiceServers["rw-router"] = []string{"mdb-0", "mdb-1"}
+
+		plan := BuildPlan(desired, managed, live)
+		Expect(plan.ConflictingListeners).To(ConsistOf("split-listener"))
+		Expect(plan.ConflictingListenerHolders).To(HaveKeyWithValue("split-listener", "rw-listener"))
+		Expect(plan.ForeignPortHolders).To(BeEmpty())
+		Expect(plan.Creates.Listeners).ToNot(ContainElement("split-listener"))
+		Expect(plan.Deletes.Listeners).To(ConsistOf("rw-listener"))
+	})
+
+	It("blocks when a non-managed live listener holds the new listener port", func() {
+		desired := newDesiredGraph()
+		svc := desired.Services["rw-router"]
+		delete(desired.Services, "rw-router")
+		delete(desired.Listeners, "rw-listener")
+		svc.Name = "split-router"
+		svc.Listener.Name = "split-listener"
+		desired.Services["split-router"] = svc
+		desired.Listeners["split-listener"] = svc.Listener
+
+		// The squatter is live but neither declared by the spec nor present in the ownership ledger.
+		live := LiveFromObjectIDs(desired.ObjectIDs())
+		live.Listeners.Add("rw-listener")
+		live.ListenerPorts[3306] = "rw-listener"
+
+		plan := BuildPlan(desired, &mariadbv1alpha1.MaxScaleConfigObjectIDs{}, live)
+		Expect(plan.ConflictingListeners).To(BeEmpty())
+		Expect(plan.ForeignPortHolders).To(HaveKeyWithValue("split-listener", "rw-listener"))
+	})
+
+	It("switches existing service relationships only when the live relationships differ", func() {
+		desired := newDesiredGraph()
+		managed := &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+			Servers:   []string{"mdb-0", "mdb-1"},
+			Monitor:   []string{"mdb-monitor"},
+			Services:  []string{"rw-router"},
+			Listeners: []string{"rw-listener"},
+		}
+		live := LiveFromObjectIDs(managed)
+		live.ServiceServers["rw-router"] = []string{"mdb-0", "mdb-1"}
+
+		Expect(BuildPlan(desired, managed, live).ServiceRelationsSwitch).To(BeEmpty())
+
+		live.ServiceServers["rw-router"] = []string{"mdb-0"}
+		Expect(BuildPlan(desired, managed, live).ServiceRelationsSwitch).To(ConsistOf("rw-router"))
+	})
+})
diff --git a/pkg/maxscale/graph/ledger.go b/pkg/maxscale/graph/ledger.go
new file mode 100644
index 00000000..65f64faf
--- /dev/null
+++ b/pkg/maxscale/graph/ledger.go
@@ -0,0 +1,111 @@
+package graph
+
+import (
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+)
+
+// Ledger is the set of MaxScale REST objects currently owned by a MaxScale CR.
+type Ledger struct {
+	servers   IDSet
+	filters   IDSet
+	monitors  IDSet
+	services  IDSet
+	listeners IDSet
+}
+
+func ledgerFromIDs(ids *mariadbv1alpha1.MaxScaleConfigObjectIDs) Ledger {
+	if ids == nil {
+		return Ledger{
+			servers:   IDSet{},
+			filters:   IDSet{},
+			monitors:  IDSet{},
+			services:  IDSet{},
+			listeners: IDSet{},
+		}
+	}
+	return Ledger{
+		servers:   setsFromIDs(ids.Servers),
+		filters:   setsFromIDs(ids.Filters),
+		monitors:  setsFromIDs(ids.Monitor),
+		services:  setsFromIDs(ids.Services),
+		listeners: setsFromIDs(ids.Listeners),
+	}
+}
+
+func (l Ledger) objectIDs() *mariadbv1alpha1.MaxScaleConfigObjectIDs {
+	return idsFromSets(l.servers, l.filters, l.monitors, l.services, l.listeners)
+}
+
+func (l Ledger) Union(other Ledger) Ledger {
+	return Ledger{
+		servers:   l.servers.Union(other.servers),
+		filters:   l.filters.Union(other.filters),
+		monitors:  l.monitors.Union(other.monitors),
+		services:  l.services.Union(other.services),
+		listeners: l.listeners.Union(other.listeners),
+	}
+}
+
+// Live is the observed MaxScale REST presence and relationships used to plan a change.
+// Presence maps are always populated; relationship maps are only needed for operation classification.
+type Live struct {
+	Servers   IDSet
+	Filters   IDSet
+	Monitors  IDSet
+	Services  IDSet
+	Listeners IDSet
+	// ListenerPorts maps a bound port to the live listener holding it.
+	ListenerPorts  map[int32]string
+	MonitorServers map[string][]string
+	ServiceServers map[string][]string
+	ServiceFilters map[string][]string
+}
+
+// NewLive returns an empty Live observation.
+func NewLive() Live {
+	return Live{
+		Servers:        IDSet{},
+		Filters:        IDSet{},
+		Monitors:       IDSet{},
+		Services:       IDSet{},
+		Listeners:      IDSet{},
+		ListenerPorts:  map[int32]string{},
+		MonitorServers: map[string][]string{},
+		ServiceServers: map[string][]string{},
+		ServiceFilters: map[string][]string{},
+	}
+}
+
+// LiveFromObjectIDs populates presence from an ID set; relationships stay empty.
+func LiveFromObjectIDs(ids *mariadbv1alpha1.MaxScaleConfigObjectIDs) Live {
+	live := NewLive()
+	if ids == nil {
+		return live
+	}
+	live.Servers = setsFromIDs(ids.Servers)
+	live.Filters = setsFromIDs(ids.Filters)
+	live.Monitors = setsFromIDs(ids.Monitor)
+	live.Services = setsFromIDs(ids.Services)
+	live.Listeners = setsFromIDs(ids.Listeners)
+	return live
+}
+
+// Adopt returns the ownership ledger for the first reconciliation after upgrade:
+// the desired objects that are also present live. Foreign live objects are never adopted.
+// A live listener squatting a desired port is not adopted either: displacing an object the CR
+// has never owned is unsafe, so that change blocks until the squatter is removed manually.
+func Adopt(desired *Graph, live Live) *mariadbv1alpha1.MaxScaleConfigObjectIDs {
+	return idsFromSets(
+		setsFromIDs(desired.serverIDs()).Intersect(live.Servers),
+		setsFromIDs(desired.filterIDs()).Intersect(live.Filters),
+		setsFromIDs(desired.monitorIDs()).Intersect(live.Monitors),
+		setsFromIDs(desired.serviceIDs()).Intersect(live.Services),
+		setsFromIDs(desired.listenerIDs()).Intersect(live.Listeners),
+	)
+}
+
+// Supersede discards a stale in-flight change and returns an updated managed ledger that
+// also owns the debris the stale change prepared, so the newer change can clean it up.
+func Supersede(managed, stalePrepared *mariadbv1alpha1.MaxScaleConfigObjectIDs) *mariadbv1alpha1.MaxScaleConfigObjectIDs {
+	return ledgerFromIDs(managed).Union(ledgerFromIDs(stalePrepared)).objectIDs()
+}
diff --git a/pkg/maxscale/graph/plan.go b/pkg/maxscale/graph/plan.go
new file mode 100644
index 00000000..f6c89b81
--- /dev/null
+++ b/pkg/maxscale/graph/plan.go
@@ -0,0 +1,190 @@
+package graph
+
+import (
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+)
+
+// Plan classifies the REST operations required to move the live graph to the desired graph.
+// Deletions are derived exclusively from the managed ledger; foreign live objects are never touched.
+type Plan struct {
+	// Creates are desired objects absent from live.
+	Creates *mariadbv1alpha1.MaxScaleConfigObjectIDs
+	// Patches are desired objects already present live (parameter-patch candidates).
+	Patches *mariadbv1alpha1.MaxScaleConfigObjectIDs
+	// Deletes are managed objects absent from the desired graph.
+	Deletes *mariadbv1alpha1.MaxScaleConfigObjectIDs
+
+	// MonitorCreate indicates that the desired monitor is absent from live and must be created stopped.
+	MonitorCreate bool
+	// MonitorRename indicates the desired monitor replaces a different managed monitor still present live.
+	MonitorRename bool
+	// MonitorRelationsSwitch indicates the same-name monitor server relationships change at the switch stage.
+	MonitorRelationsSwitch bool
+
+	// ConflictingListeners are desired listeners whose port is held by a live, non-desired listener
+	// that the ledger owns: they are created at the switch stage, right after the holder is removed.
+	ConflictingListeners []string
+	// ConflictingListenerHolders maps a conflicting desired listener ID to the live listener
+	// holding its port. Only ledger-owned holders are listed here.
+	ConflictingListenerHolders map[string]string
+	// ForeignPortHolders maps desired listener IDs to live holders that are not in the ownership
+	// ledger. They block the change and must not be deleted by the operator.
+	ForeignPortHolders map[string]string
+	// ServiceRelationsSwitch are existing services whose servers/filters relationships change at the switch stage.
+	ServiceRelationsSwitch []string
+}
+
+// BuildPlan classifies operations from the desired graph, the managed ownership ledger and the live observation.
+func BuildPlan(desired *Graph, managed *mariadbv1alpha1.MaxScaleConfigObjectIDs, live Live) *Plan {
+	desiredServers := setsFromIDs(desired.serverIDs())
+	desiredFilters := setsFromIDs(desired.filterIDs())
+	desiredMonitors := setsFromIDs(desired.monitorIDs())
+	desiredServices := setsFromIDs(desired.serviceIDs())
+	desiredListeners := setsFromIDs(desired.listenerIDs())
+
+	ledger := ledgerFromIDs(managed)
+
+	allHolders := listenerPortHolders(desired, live)
+	conflictList := conflictingListeners(desired, live, ledger)
+	foreignHolders := foreignPortHolders(desired, live, ledger)
+	blockedListeners := setsFromIDs(keysOf(allHolders))
+	creates := idsFromSets(
+		desiredServers.Minus(live.Servers),
+		desiredFilters.Minus(live.Filters),
+		desiredMonitors.Minus(live.Monitors),
+		desiredServices.Minus(live.Services),
+		desiredListeners.Minus(live.Listeners).Minus(blockedListeners),
+	)
+	patches := idsFromSets(
+		desiredServers.Intersect(live.Servers),
+		desiredFilters.Intersect(live.Filters),
+		desiredMonitors.Intersect(live.Monitors),
+		desiredServices.Intersect(live.Services),
+		desiredListeners.Intersect(live.Listeners),
+	)
+	deletes := idsFromSets(
+		ledger.servers.Minus(desiredServers),
+		ledger.filters.Minus(desiredFilters),
+		ledger.monitors.Minus(desiredMonitors),
+		ledger.services.Minus(desiredServices),
+		ledger.listeners.Minus(desiredListeners),
+	)
+
+	monitorID := ""
+	if ids := desired.monitorIDs(); len(ids) > 0 {
+		monitorID = ids[0]
+	}
+	monitorCreate := monitorID != "" && !live.Monitors.Contains(monitorID)
+	monitorRename := monitorCreate && setsFromIDs(deletes.Monitor).ContainsOtherThan(monitorID)
+
+	plan := &Plan{
+		Creates:                    creates,
+		Patches:                    patches,
+		Deletes:                    deletes,
+		MonitorCreate:              monitorCreate,
+		MonitorRename:              monitorRename,
+		MonitorRelationsSwitch:     monitorID != "" && monitorRelationsChanged(desired, monitorID, live),
+		ConflictingListeners:       conflictList,
+		ConflictingListenerHolders: conflictHolders(allHolders, conflictList),
+		ForeignPortHolders:         foreignHolders,
+		ServiceRelationsSwitch:     serviceRelationsChanged(desired, live),
+	}
+	return plan
+}
+
+func monitorRelationsChanged(desired *Graph, monitorID string, live Live) bool {
+	mon, ok := desired.Monitors[monitorID]
+	if !ok {
+		return false
+	}
+	liveServers, ok := live.MonitorServers[monitorID]
+	if !ok {
+		return false
+	}
+	return !sameStringSet(mon.Servers, liveServers)
+}
+
+func serviceRelationsChanged(desired *Graph, live Live) []string {
+	changed := IDSet{}
+	for _, id := range desired.serviceIDs() {
+		svc := desired.Services[id]
+		liveServers, ok := live.ServiceServers[id]
+		if ok && !sameStringSet(svc.Servers, liveServers) {
+			changed.Add(id)
+			continue
+		}
+		liveFilters, ok := live.ServiceFilters[id]
+		if ok && !sameStringSet(svc.Filters, liveFilters) {
+			changed.Add(id)
+		}
+	}
+	return changed.Sorted()
+}
+
+// conflictingListeners returns desired listeners that cannot bind during preparation because a
+// live listener owned by the MaxScale CR still holds their port and is being removed.
+func conflictingListeners(desired *Graph, live Live, ledger Ledger) []string {
+	holders := listenerPortHolders(desired, live)
+	conflicting := make([]string, 0, len(holders))
+	for id, holder := range holders {
+		if ledger.listeners.Contains(holder) {
+			conflicting = append(conflicting, id)
+		}
+	}
+	return SortedCopy(conflicting)
+}
+
+// foreignPortHolders maps desired listeners to live port holders that are not in the ownership
+// ledger and therefore must not be removed by the operator.
+func foreignPortHolders(desired *Graph, live Live, ledger Ledger) map[string]string {
+	holders := listenerPortHolders(desired, live)
+	foreign := map[string]string{}
+	for id, holder := range holders {
+		if !ledger.listeners.Contains(holder) {
+			foreign[id] = holder
+		}
+	}
+	return foreign
+}
+
+// listenerPortHolders maps every conflicting desired listener to the live listener holding its port.
+func listenerPortHolders(desired *Graph, live Live) map[string]string {
+	holders := map[string]string{}
+	for _, id := range desired.listenerIDs() {
+		listener := desired.Listeners[id]
+		holder, ok := live.ListenerPorts[listener.Port]
+		if !ok || holder == id {
+			continue
+		}
+		// The holder survives in the desired graph, so the collision is a spec validation problem.
+		if live.Listeners.Contains(holder) && setsFromIDs(desired.listenerIDs()).Contains(holder) {
+			continue
+		}
+		holders[id] = holder
+	}
+	return holders
+}
+
+// conflictHolders restricts the holder map to the conflicting desired listener IDs.
+func conflictHolders(holders map[string]string, conflictList []string) map[string]string {
+	wanted := setsFromIDs(conflictList)
+	filtered := map[string]string{}
+	for id, holder := range holders {
+		if wanted.Contains(id) {
+			filtered[id] = holder
+		}
+	}
+	return filtered
+}
+
+func sameStringSet(a, b []string) bool {
+	return setsFromIDs(a).Equal(setsFromIDs(b))
+}
+
+func keysOf(m map[string]string) []string {
+	ids := make([]string, 0, len(m))
+	for id := range m {
+		ids = append(ids, id)
+	}
+	return SortedCopy(ids)
+}
diff --git a/pkg/maxscale/graph/sets.go b/pkg/maxscale/graph/sets.go
new file mode 100644
index 00000000..1a192472
--- /dev/null
+++ b/pkg/maxscale/graph/sets.go
@@ -0,0 +1,118 @@
+package graph
+
+import (
+	"sort"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+)
+
+type IDSet map[string]struct{}
+
+func newIDSet(ids ...string) IDSet {
+	set := make(IDSet, len(ids))
+	for _, id := range ids {
+		set[id] = struct{}{}
+	}
+	return set
+}
+
+func (s IDSet) Add(id string) {
+	s[id] = struct{}{}
+}
+
+// Remove deletes an ID from the set.
+func (s IDSet) Remove(id string) {
+	delete(s, id)
+}
+
+func (s IDSet) Contains(id string) bool {
+	_, ok := s[id]
+	return ok
+}
+
+func (s IDSet) Sorted() []string {
+	ids := make([]string, 0, len(s))
+	for id := range s {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+func (s IDSet) Union(other IDSet) IDSet {
+	merged := make(IDSet, len(s)+len(other))
+	for id := range s {
+		merged[id] = struct{}{}
+	}
+	for id := range other {
+		merged[id] = struct{}{}
+	}
+	return merged
+}
+
+func (s IDSet) Intersect(other IDSet) IDSet {
+	result := make(IDSet)
+	for id := range s {
+		if other.Contains(id) {
+			result.Add(id)
+		}
+	}
+	return result
+}
+
+// minus returns the IDs present in s but not in other.
+func (s IDSet) Minus(other IDSet) IDSet {
+	result := make(IDSet)
+	for id := range s {
+		if !other.Contains(id) {
+			result.Add(id)
+		}
+	}
+	return result
+}
+
+func (s IDSet) Equal(other IDSet) bool {
+	if len(s) != len(other) {
+		return false
+	}
+	for id := range s {
+		if !other.Contains(id) {
+			return false
+		}
+	}
+	return true
+}
+
+// containsOtherThan reports whether the set has any ID different from the given one.
+func (s IDSet) ContainsOtherThan(id string) bool {
+	for current := range s {
+		if current != id {
+			return true
+		}
+	}
+	return false
+}
+
+// SameStrings reports whether two slices contain the same string set, ignoring order and duplicates.
+func SameStrings(a, b []string) bool {
+	return setsFromIDs(a).Equal(setsFromIDs(b))
+}
+
+func setsFromIDs(ids []string) IDSet {
+	return newIDSet(ids...)
+}
+
+func idsFromSets(servers, filters, monitors, services, listeners IDSet) *mariadbv1alpha1.MaxScaleConfigObjectIDs {
+	return &mariadbv1alpha1.MaxScaleConfigObjectIDs{
+		Servers:   servers.Sorted(),
+		Filters:   filters.Sorted(),
+		Monitor:   monitors.Sorted(),
+		Services:  services.Sorted(),
+		Listeners: listeners.Sorted(),
+	}
+}
+
+func SortedStrings(ids []string) []string {
+	sort.Strings(ids)
+	return ids
+}
