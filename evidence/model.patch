+func TestFileSystemCompletionAndCleanup(t *testing.T) {
+	ctx := context.Background()
+	basePath := t.TempDir()
+	storage := NewFileSystemBackupStorage(basePath, NewPhysicalBackupProcessor(), ctrl.Log)
+
