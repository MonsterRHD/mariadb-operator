--- /dev/null
+++ b/pkg/connection/connection.go
@@ -0,0 +1,83 @@
+// Package connection builds the connection data published by the Connection controller into a Secret.
+package connection
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"text/template"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+	"github.com/mariadb-operator/mariadb-operator/v26/pkg/hash"
+	clientsql "github.com/mariadb-operator/mariadb-operator/v26/pkg/sql"
+)
+
+// BuildSecretData builds the whole set of Secret keys for a connection candidate: the DSN, the
+// custom format when defined and the optional split fields. All keys are produced together so
+// they are published atomically as a single generation.
+func BuildSecretData(conn *mariadbv1alpha1.Connection, opts clientsql.Opts) (map[string][]byte, error) {
+	dsn, err := clientsql.BuildDSN(opts)
+	if err != nil {
+		return nil, fmt.Errorf("error building DSN: %v", err)
+	}
+
+	data := map[string][]byte{
+		conn.SecretKey(): []byte(dsn),
+	}
+	if formatString := conn.Spec.SecretTemplate.Format; formatString != nil {
+		tmpl, err := template.New("").Parse(*formatString)
+		if err != nil {
+			return nil, fmt.Errorf("error parsing DSN template: %v", err)
+		}
+		builder := &strings.Builder{}
+		if err := tmpl.Execute(builder, formatData(opts)); err != nil {
+			return nil, fmt.Errorf("error executing DSN template: %v", err)
+		}
+		data[conn.SecretKey()] = []byte(builder.String())
+	}
+	if usernameKey := conn.Spec.SecretTemplate.UsernameKey; usernameKey != nil {
+		data[*usernameKey] = []byte(opts.Username)
+	}
+	if passwordKey := conn.Spec.SecretTemplate.PasswordKey; passwordKey != nil {
+		data[*passwordKey] = []byte(opts.Password)
+	}
+	if hostKey := conn.Spec.SecretTemplate.HostKey; hostKey != nil {
+		data[*hostKey] = []byte(opts.Host)
+	}
+	if portKey := conn.Spec.SecretTemplate.PortKey; portKey != nil {
+		data[*portKey] = []byte(strconv.Itoa(int(opts.Port)))
+	}
+	if databaseKey := conn.Spec.SecretTemplate.DatabaseKey; databaseKey != nil && opts.Database != "" {
+		data[*databaseKey] = []byte(opts.Database)
+	}
+	return data, nil
+}
+
+func formatData(opts clientsql.Opts) map[string]string {
+	return map[string]string{
+		"Username": opts.Username,
+		"Password": opts.Password,
+		"Host":     opts.Host,
+		"Port":     strconv.Itoa(int(opts.Port)),
+		"Database": opts.Database,
+		"Params": func() string {
+			v := url.Values{}
+			for key, value := range opts.Params {
+				v.Add(key, value)
+			}
+			s := v.Encode()
+			if s == "" {
+				return s
+			}
+			return fmt.Sprintf("?%s", s)
+		}(),
+	}
+}
+
+// Version is the fingerprint of a connection generation: it changes whenever the referenced
+// object, credentials, TLS material or templates that produce the Secret data change. It is
+// persisted in the Connection status and used to detect stale candidates across restarts.
+func Version(data map[string][]byte) (string, error) {
+	return hash.HashJSON(data)
+}
diff --git a/pkg/connection/connection_test.go b/pkg/connection/connection_test.go
new file mode 100644
index 000000000..01aa89389
--- /dev/null
+++ b/pkg/connection/connection_test.go
@@ -0,0 +1,126 @@
+package connection
+
+import (
+	"testing"
+
+	mariadbv1alpha1 "github.com/mariadb-operator/mariadb-operator/v26/api/v1alpha1"
+	clientsql "github.com/mariadb-operator/mariadb-operator/v26/pkg/sql"
+	"k8s.io/utils/ptr"
+)
+
+func newTestConnection() *mariadbv1alpha1.Connection {
+	return &mariadbv1alpha1.Connection{
+		Spec: mariadbv1alpha1.ConnectionSpec{
+			ConnectionTemplate: mariadbv1alpha1.ConnectionTemplate{
+				SecretTemplate: &mariadbv1alpha1.SecretTemplate{
+					Key: ptr.To("dsn"),
+				},
+			},
+		},
+	}
+}
+
+func newTestOpts() clientsql.Opts {
+	return clientsql.Opts{
+		Username: "app",
+		Password: "pass",
+		Host:     "mariadb.default.svc.cluster.local",
+		Port:     3306,
+		Database: "app",
+	}
+}
+
+func TestBuildSecretData(t *testing.T) {
+	conn := newTestConnection()
+	conn.Spec.SecretTemplate.UsernameKey = ptr.To("username")
+	conn.Spec.SecretTemplate.PasswordKey = ptr.To("password")
+	conn.Spec.SecretTemplate.HostKey = ptr.To("host")
+	conn.Spec.SecretTemplate.PortKey = ptr.To("port")
+	conn.Spec.SecretTemplate.DatabaseKey = ptr.To("database")
+	conn.Spec.SecretTemplate.Format = ptr.To("mysql://{{ .Username }}:{{ .Password }}@{{ .Host }}:{{ .Port }}/{{ .Database }}")
+
+	data, err := BuildSecretData(conn, newTestOpts())
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	want := map[string]string{
+		"dsn":      "mysql://app:pass@mariadb.default.svc.cluster.local:3306/app",
+		"username": "app",
+		"password": "pass",
+		"host":     "mariadb.default.svc.cluster.local",
+		"port":     "3306",
+		"database": "app",
+	}
+	for key, value := range want {
+		if string(data[key]) != value {
+			t.Errorf("key %q = %q, want %q", key, string(data[key]), value)
+		}
+	}
+}
+
+func TestBuildSecretDataInvalidTemplate(t *testing.T) {
+	conn := newTestConnection()
+	conn.Spec.SecretTemplate.Format = ptr.To("mysql://{{ .Invalid ")
+
+	if _, err := BuildSecretData(conn, newTestOpts()); err == nil {
+		t.Fatal("expected error for invalid template, got nil")
+	}
+}
+
+func TestVersionChangesWithGeneration(t *testing.T) {
+	conn := newTestConnection()
+	opts := newTestOpts()
+
+	data, err := BuildSecretData(conn, opts)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	version, err := Version(data)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	// Same inputs must always produce the same version (restart safe).
+	sameData, err := BuildSecretData(conn, opts)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	sameVersion, err := Version(sameData)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if version != sameVersion {
+		t.Errorf("version not stable: %q != %q", version, sameVersion)
+	}
+
+	// A parent endpoint change produces a new generation.
+	changedOpts := opts
+	changedOpts.Host = "mariadb-primary.default.svc.cluster.local"
+	changedData, err := BuildSecretData(conn, changedOpts)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	changedVersion, err := Version(changedData)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if version == changedVersion {
+		t.Errorf("version did not change after host update: %q", version)
+	}
+
+	// A credential change produces a new generation.
+	credOpts := opts
+	credOpts.Password = "new-pass"
+	credData, err := BuildSecretData(conn, credOpts)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	credVersion, err := Version(credData)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if version == credVersion {
+		t.Errorf("version did not change after password update: %q", version)
+	}
+}
